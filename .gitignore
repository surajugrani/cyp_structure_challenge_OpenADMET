# ── Large model outputs (keep final submission PDBs + summary tables only) ──
**/raw_outputs/
*.cif.gz
*_embeddings.npz
*_confidences.json
*.npz
*.pkl

# ── Schrödinger / ICM intermediates ──
*.maegz
*.mae
*.sdfgz
*.zip
*.map
*.ob
*.dtb
*.icb
*_LOG.htm
*.log

# ── MSAs and templates can be large; commit only small curated ones explicitly ──
*.a3m
*.mtz

# ── SLURM job logs ──
slurm-*.out
*.err

# ── Python / environment ──
__pycache__/
*.pyc
.ipynb_checkpoints/
.env

# ── Editor / OS ──
.DS_Store
*.swp
*~

# ── Per-analysis working structures (PDB downloads, prepped complexes, grids) ──
analyses/*/structures/
analyses/*/slurm-*.out
analyses/*/structures/

# ── Locally vendored Python deps (see analyses/05_*/README.md for install cmd) ──
.pylibs/

# Boltz-2 predictions and packaged submissions (large, regenerable)
submissions/*/results/boltz_results_*/
submissions/*/submission/
submissions/*/*.zip
submissions/*/slurm-*.out

# ── AF3 raw per-sample model outputs and Schrodinger work dirs ──
# Regenerable from inputs/ + scripts/, and ~0.5 GB per submission. Submission 07
# tracked these before the rule existed; see submissions/README.md.
submissions/*/results/ocnt-*/
submissions/*/results/_tmp/

# Any Schrodinger/AF3 work dir at any depth. The earlier rule was
# submissions/*/work/, which missed submissions/04_af3_default/glide_rescoring/work/
# - 496 MB of it. Match at any depth instead.
**/work/

# Combined multi-MODEL PDBs for PyMOL (regenerable: tools/make_combined_pdb.py)
submissions/*/visualize/
tools/slurm-*.out

# Boltz raw per-sample predictions (regenerable, ~GB)
submissions/*/results/boltz_results_*/
submissions/*/raw_model0/

# Glide per-sample work dirs (regenerable)
analyses/*/work/
analyses/*/samples/

# API tokens must never enter the repo (stored at ~/.cyp_biohub_token, mode 600)
*token*
*.key
